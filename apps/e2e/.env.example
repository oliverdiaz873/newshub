# newshub-e2e — local E2E environment (copy to a gitignored .env.e2e
# and `set`/`export` the vars before `npm test`, or export them directly).
# Real passwords/secrets live ONLY here or in CI job env — never in code.
# Values must match the users created by the E2E seed
# (apps/api/prisma/seed.ts, dev-only credentials) unless the seed is customized.

# Isolated E2E database (non-sensitive local default in code; override for CI).
E2E_DATABASE_URL="postgresql://postgres@localhost:5433/newshub_e2e"

# Test identities (emails are non-sensitive identifiers).
E2E_EDITOR_EMAIL="editor@newshub.local"
E2E_EDITOR_PASSWORD=""
E2E_REVIEWER_EMAIL="reviewer@newshub.local"
E2E_REVIEWER_PASSWORD=""
E2E_ADMIN_EMAIL="admin@newshub.local"
E2E_ADMIN_PASSWORD=""

# JWT secret the E2E API boots with (any test-only value; isolated database).
E2E_JWT_SECRET=""

# Optional overrides (non-sensitive local defaults live in code).
# E2E_API_URL="http://localhost:3211/api/v1"
