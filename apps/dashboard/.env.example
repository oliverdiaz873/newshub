# Newshub dashboard — local development (copy to .env.local, never commit env files)
# IMPORTANT: the regular local API runs on port 3001. Port 3211 is reserved for E2E.
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# Origin serving legacy seeded images referenced as /images/ paths.
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"
