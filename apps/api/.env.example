# Newshub API — local development (copy to .env, never commit .env)
# PostgreSQL 17.x user-space instance: C:\Users\dell\pgsql, port 5433
DATABASE_URL="postgresql://postgres@localhost:5433/newshub_dev"
TEST_DATABASE_URL="postgresql://postgres@localhost:5433/newshub_test"
PORT=3001
# Dashboard origin allowed for cookie-based refresh (dev default).
DASHBOARD_URL="http://localhost:3002"
# Auth (ADR-010). Dev fallback exists for JWT_SECRET; set a strong value in production.
JWT_SECRET="change-me-in-production"
# Provisional defaults; exact TTLs stay open per ADR-010.
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
