// Data Model v2 (locked) — Prisma schema, F1 public-reading subset.
// Conventions: UUID PKs (@default(uuid()) client-side, no pgcrypto needed),
// snake_case tables/columns, translations as separate tables, content as JSONB.
// DB-level CHECKs and partial indexes are appended in the initial migration SQL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String   @map("display_name")
  role        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  createdCategories Category[]   @relation("CategoryCreatedBy")
  updatedCategories Category[]   @relation("CategoryUpdatedBy")
  createdArticles   Article[]    @relation("ArticleCreatedBy")
  updatedArticles   Article[]    @relation("ArticleUpdatedBy")
  scheduledArticles Article[]    @relation("ArticleScheduledBy")
  createdOpinions   Opinion[]    @relation("OpinionCreatedBy")
  updatedOpinions   Opinion[]    @relation("OpinionUpdatedBy")
  scheduledOpinions Opinion[]    @relation("OpinionScheduledBy")
  createdMedia      MediaAsset[] @relation("MediaCreatedBy")
  credentials     UserCredential?
  refreshTokens   RefreshToken[]
  revisions       Revision[]     @relation("RevisionActor")
  auditEvents     AuditEvent[]   @relation("AuditActor")
  assignedItems   PlanningItem[] @relation("PlanningAssignee")
  reviewingItems  PlanningItem[] @relation("PlanningReviewer")
  createdItems    PlanningItem[] @relation("PlanningCreatedBy")
  updatedItems    PlanningItem[] @relation("PlanningUpdatedBy")
  webhooks        Webhook[]      @relation("WebhookCreatedBy")
  notifications   Notification[] @relation("NotificationUser")
  notificationsSent Notification[] @relation("NotificationActor")
  notificationPrefs NotificationPref[] @relation("NotificationPrefUser")

  @@map("users")
}

model Author {
  id         String               @id @default(uuid()) @db.Uuid
  slug       String               @unique
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  translations AuthorTranslation[]
  articles   Article[]
  opinions   Opinion[]

  @@map("authors")
}

model AuthorTranslation {
  authorId String @map("author_id") @db.Uuid
  locale   String
  name     String
  bio      String?
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([authorId, locale])
  @@unique([locale, name])
  @@map("author_translations")
}

model Category {
  id          String                @id @default(uuid()) @db.Uuid
  sort        Int                   @default(0)
  createdById String?               @map("created_by") @db.Uuid
  updatedById String?               @map("updated_by") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   User?                 @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?                 @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  translations CategoryTranslation[]
  articles    Article[]
  planningItems PlanningItem[]

  @@map("categories")
}

model CategoryTranslation {
  categoryId  String   @map("category_id") @db.Uuid
  locale      String
  slug        String
  label       String
  description String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

model Article {
  id           String               @id @default(uuid()) @db.Uuid
  categoryId   String               @map("category_id") @db.Uuid
  authorId     String?              @map("author_id") @db.Uuid
  coverMediaId String?              @map("cover_media_id") @db.Uuid
  status       String               @default("draft")
  publishedAt  DateTime?            @map("published_at") @db.Timestamptz
  scheduledAt  DateTime?            @map("scheduled_at") @db.Timestamptz
  scheduledById String?             @map("scheduled_by") @db.Uuid
  scheduledBy  User?                @relation("ArticleScheduledBy", fields: [scheduledById], references: [id], onDelete: SetNull)
  isBreaking   Boolean              @default(false) @map("is_breaking")
  isFeatured   Boolean              @default(false) @map("is_featured")
  createdById  String?              @map("created_by") @db.Uuid
  updatedById  String?              @map("updated_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author       Author?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  cover        MediaAsset?          @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("ArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                @relation("ArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  translations ArticleTranslation[]

  @@index([authorId])
  @@map("articles")
}

model ArticleTranslation {
  articleId String  @map("article_id") @db.Uuid
  locale    String
  slug      String
  title     String
  summary   String
  coverAlt  String? @map("cover_alt")
  content   Json
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, locale])
  @@unique([locale, slug])
  @@map("article_translations")
}

model Opinion {
  id           String               @id @default(uuid()) @db.Uuid
  authorId     String               @map("author_id") @db.Uuid
  coverMediaId String?              @map("cover_media_id") @db.Uuid
  status       String               @default("draft")
  publishedAt  DateTime?            @map("published_at") @db.Timestamptz
  scheduledAt  DateTime?            @map("scheduled_at") @db.Timestamptz
  scheduledById String?             @map("scheduled_by") @db.Uuid
  scheduledBy  User?                @relation("OpinionScheduledBy", fields: [scheduledById], references: [id], onDelete: SetNull)
  createdById  String?              @map("created_by") @db.Uuid
  updatedById  String?              @map("updated_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  author       Author               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  cover        MediaAsset?          @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("OpinionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                @relation("OpinionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  translations OpinionTranslation[]

  @@index([authorId])
  @@map("opinions")
}

model OpinionTranslation {
  opinionId String  @map("opinion_id") @db.Uuid
  locale    String
  slug      String
  title     String
  summary   String
  coverAlt  String? @map("cover_alt")
  content   Json
  opinion   Opinion @relation(fields: [opinionId], references: [id], onDelete: Cascade)

  @@id([opinionId, locale])
  @@unique([locale, slug])
  @@map("opinion_translations")
}

model MediaAsset {
  id          String    @id @default(uuid()) @db.Uuid
  storageKey  String    @unique @map("storage_key")
  mime        String
  width       Int?
  height      Int?
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy   User?     @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  articles    Article[]
  opinions    Opinion[]

  @@map("media_assets")
}

model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Revision {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  version    Int
  actorId    String?  @map("actor_id") @db.Uuid
  cause      String
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  actor      User?    @relation("RevisionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, version(sort: Desc)])
  @@map("revisions")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?    @map("metadata")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at(sort: Desc)])
  @@index([entityType, entityId, at(sort: Desc)])
  @@map("audit_events")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  payload    Json?     @map("payload")
  readAt     DateTime? @map("read_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user       User      @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPref {
  userId     String   @id @map("user_id") @db.Uuid
  mutedTypes String[] @map("muted_types")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user       User     @relation("NotificationPrefUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_prefs")
}

model PlanningItem {
  id           String    @id @default(uuid()) @db.Uuid
  type         String
  title        String
  description  String?
  categoryId   String?   @map("category_id") @db.Uuid
  assigneeId   String?   @map("assignee_id") @db.Uuid
  reviewerId   String?   @map("reviewer_id") @db.Uuid
  priority     String    @default("normal")
  status       String    @default("pitched")
  dueAt        DateTime? @map("due_at") @db.Timestamptz
  entityType   String?   @map("entity_type")
  entityId     String?   @map("entity_id") @db.Uuid
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignee     User?     @relation("PlanningAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewer     User?     @relation("PlanningReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdBy    User?     @relation("PlanningCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?     @relation("PlanningUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueAt])
  @@index([status, dueAt])
  @@index([dueAt])
  @@index([reviewerId])
  @@index([categoryId])
  @@index([type])
  @@map("planning_items")
}

model Webhook {
  id         String   @id @default(uuid()) @db.Uuid
  url        String
  secretHash String   @map("secret_hash")
  events     String[]
  active     Boolean  @default(true)
  createdById String? @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  User?    @relation("WebhookCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id") @db.Uuid
  action         String
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz
  payload        Json?
  responseCode   Int?      @map("response_code")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  subscription   Webhook   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, entityType, entityId, action])
  @@index([status, nextAttemptAt])
  @@index([subscriptionId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}
